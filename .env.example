# Copiá este archivo a ".env" para desarrollo local (nunca se sube a git),
# y cargá estos mismos nombres en Netlify > Site configuration > Environment variables.

# --- Supabase (Project Settings > API) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudinary (Dashboard > cloud name, y Settings > Upload > Upload presets) ---
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=
