---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase.js';
import { optimizar } from '../../lib/imagenes.js';

export async function getStaticPaths() {
  const { data: propiedades } = await supabase.from('propiedades').select('*');
  return propiedades.map((prop) => ({
    params: { id: prop.id },
    props: { prop },
  }));
}

const { prop } = Astro.props;

const whatsapp = import.meta.env.PUBLIC_WHATSAPP || "5491123456789";
const mensajeWsp = `¡Hola! Me interesa la propiedad "${prop.titulo}" que vi en la web. ¿Me darían más información?`;
const linkWsp = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensajeWsp)}`;

// Fotos reales: la galería si existe, si no la portada. Sin fotos de relleno.
const galeria = ((Array.isArray(prop.galeria) && prop.galeria.length) ? prop.galeria : [prop.imagen_principal]).filter(Boolean);
const videoYoutube = prop.video_url || null;
---

<MainLayout title={prop.titulo}>
  
  <div class="bg-slate-50 border-b border-slate-100 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-4 text-sm font-medium text-slate-500">
      <a href="/propiedades" class="hover:text-blue-600 transition-colors">&larr; Volver al catálogo</a>
      <span>/</span>
      <span class="text-slate-900">{prop.tipo_propiedad} en {prop.operacion}</span>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="mb-8 flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="bg-blue-600 text-white text-xs font-black px-3 py-1.5 rounded-lg uppercase tracking-wider">{prop.operacion}</span>
          <span class="bg-slate-100 text-slate-600 text-xs font-bold px-3 py-1.5 rounded-lg uppercase tracking-wider">{prop.tipo_propiedad}</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight">{prop.titulo}</h1>
      </div>
      <div class="text-left md:text-right flex-shrink-0">
        <p class="text-sm font-bold text-slate-500 uppercase tracking-wide mb-1">Precio de {prop.operacion}</p>
        <p class="text-4xl font-black text-blue-600">{prop.moneda} {prop.precio.toLocaleString('es-AR')}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 h-[400px] md:h-[500px] rounded-3xl overflow-hidden mb-12 group cursor-pointer">
      <div class="md:col-span-2 h-full relative overflow-hidden">
        {galeria[0]
          ? <img src={optimizar(galeria[0], 1200)} data-full={optimizar(galeria[0], 1920)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          : <div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-400 text-lg font-semibold">📷 Fotos próximamente</div>}
      </div>
      <div class="hidden md:grid grid-rows-2 gap-3 col-span-2 h-full">
        <div class="grid grid-cols-2 gap-3 h-full">
          <div class="relative overflow-hidden h-full">{galeria[1] ? <img src={optimizar(galeria[1], 600)} data-full={optimizar(galeria[1], 1920)} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /> : <div class="w-full h-full bg-slate-100"></div>}</div>
          <div class="relative overflow-hidden h-full">{galeria[2] ? <img src={optimizar(galeria[2], 600)} data-full={optimizar(galeria[2], 1920)} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /> : <div class="w-full h-full bg-slate-100"></div>}</div>
        </div>
        <div class="grid grid-cols-2 gap-3 h-full">
          <div class="relative overflow-hidden h-full">{galeria[3] ? <img src={optimizar(galeria[3], 600)} data-full={optimizar(galeria[3], 1920)} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /> : <div class="w-full h-full bg-slate-100"></div>}</div>
          <div class="relative overflow-hidden h-full">
            {galeria[4] ? (
              <>
                <img src={optimizar(galeria[4], 600)} data-full={optimizar(galeria[4], 1920)} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-slate-900/40 hover:bg-slate-900/20 transition-colors flex items-center justify-center">
                  <span class="text-white font-bold text-lg drop-shadow-md">Ver Galería</span>
                </div>
              </>
            ) : <div class="w-full h-full bg-slate-100"></div>}
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <div class="lg:col-span-2 space-y-12">
        
        <div class="flex flex-wrap gap-6 py-6 border-y border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center text-2xl">🛏️</div>
            <div><p class="text-sm text-slate-500 font-medium">Ambientes</p><p class="font-bold text-slate-900">{prop.ambientes}</p></div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center text-2xl">🛁</div>
            <div><p class="text-sm text-slate-500 font-medium">Baños</p><p class="font-bold text-slate-900">{prop.banios}</p></div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center text-2xl">📐</div>
            <div><p class="text-sm text-slate-500 font-medium">Superficie</p><p class="font-bold text-slate-900">{prop.metros_cuadrados} m²</p></div>
          </div>
        </div>

        <section>
          <h2 class="text-2xl font-black text-slate-900 mb-6">Acerca de la propiedad</h2>
          <div class="prose prose-lg text-slate-600">
            <p class="whitespace-pre-line leading-relaxed">{prop.descripcion}</p>
          </div>
        </section>

        {videoYoutube && (
        <section class="pt-8 border-t border-slate-100">
          <h2 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-2">
            <span>🎥</span> Recorrido Virtual
          </h2>
          <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-100 aspect-video bg-slate-100">
            <iframe 
              class="w-full h-full" 
              src={videoYoutube} 
              title="Recorrido en Video" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen>
            </iframe>
          </div>
        </section>
        )}

        {prop.mapa_url && (
          <section class="pt-8 border-t border-slate-100">
            <h2 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-2">
              <span>📍</span> Ubicación
            </h2>
            <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-100 aspect-video bg-slate-100">
              <iframe 
                src={prop.mapa_url} 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
          </section>
        )}

      </div>

      <div class="relative">
        <div class="bg-white p-8 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 sticky top-28">
          <h3 class="text-xl font-bold text-slate-900 mb-2">¿Te interesa esta propiedad?</h3>
          <p class="text-slate-500 text-sm mb-6">Contactanos ahora para agendar una visita o consultar dudas. Respondemos al instante.</p>
          
          <a href={linkWsp} target="_blank" class="flex items-center justify-center gap-3 w-full bg-[#25D366] hover:bg-[#1ebe57] transition-all transform hover:-translate-y-1 text-white font-bold py-4 px-6 rounded-xl shadow-lg shadow-green-200 mb-4">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Contactar por WhatsApp
          </a>

          <a href="/contacto" class="block text-center w-full bg-slate-100 hover:bg-slate-200 transition-colors text-slate-700 font-bold py-4 px-6 rounded-xl">
            Enviar un Email
          </a>
          
          <div class="mt-8 pt-6 border-t border-slate-100">
            <p class="text-xs text-slate-400 text-center uppercase tracking-widest font-bold">Garantía de confianza</p>
            <div class="flex justify-center gap-4 mt-4 opacity-50">
              <span class="text-2xl">🔒</span>
              <span class="text-2xl">📄</span>
              <span class="text-2xl">🤝</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <div id="lightbox" class="fixed inset-0 z-[100] bg-slate-900/95 hidden flex-col items-center justify-center backdrop-blur-md transition-opacity duration-300 opacity-0">
      <button id="cerrar-lightbox" class="absolute top-6 right-6 text-white hover:text-red-400 transition-colors z-50 p-2 cursor-pointer">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      
      <div class="relative w-full max-w-6xl md:px-12 flex items-center justify-between h-full">
         <button id="prev-img" class="text-white hover:text-blue-400 p-4 z-50 bg-slate-800/50 md:bg-transparent rounded-full ml-2 md:ml-0 transition-colors">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
         </button>
         
         <img id="img-lightbox" src="" class="max-h-[85vh] max-w-full object-contain shadow-2xl rounded-lg transition-all" />
         
         <button id="next-img" class="text-white hover:text-blue-400 p-4 z-50 bg-slate-800/50 md:bg-transparent rounded-full mr-2 md:mr-0 transition-colors">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
         </button>
      </div>
      
      <p id="contador-lightbox" class="absolute bottom-6 text-slate-400 font-bold tracking-widest text-sm"></p>
    </div>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Seleccionamos los elementos
    const lightbox = document.getElementById('lightbox');
    const imgLightbox = document.getElementById('img-lightbox');
    const btnCerrar = document.getElementById('cerrar-lightbox');
    const btnNext = document.getElementById('next-img');
    const btnPrev = document.getElementById('prev-img');
    const contador = document.getElementById('contador-lightbox');
    
    // Agarramos todas las fotos que están dentro de la galería (el div de las 5 fotos)
    const galeriaContenedor = document.querySelector('.grid.grid-cols-1.md\\:grid-cols-4');
    if (!galeriaContenedor) return; // Por si no hay galería
    
    const imagenesGaleria = Array.from(galeriaContenedor.querySelectorAll('img'));
    let currentIndex = 0;

    // 2. Función para abrir el lightbox
    const abrirLightbox = (index) => {
      currentIndex = index;
      actualizarImagen();
      
      // Mostramos el modal con animación
      lightbox.classList.remove('hidden');
      // Pequeño delay para que la transición de opacidad funcione
      setTimeout(() => lightbox.classList.remove('opacity-0'), 10);
      document.body.style.overflow = 'hidden'; // Evita que la página scrollee de fondo
    };

    // 3. Función para cerrar
    const cerrarLightbox = () => {
      lightbox.classList.add('opacity-0');
      setTimeout(() => {
        lightbox.classList.add('hidden');
        document.body.style.overflow = 'auto'; // Devuelve el scroll a la página
      }, 300);
    };

    // 4. Función para cambiar la foto
    const actualizarImagen = () => {
      imgLightbox.src = imagenesGaleria[currentIndex].dataset.full || imagenesGaleria[currentIndex].src;
      contador.innerText = `${currentIndex + 1} / ${imagenesGaleria.length}`;
    };

    const siguienteFoto = () => {
      currentIndex = (currentIndex + 1) % imagenesGaleria.length;
      actualizarImagen();
    };

    const fotoAnterior = () => {
      currentIndex = (currentIndex - 1 + imagenesGaleria.length) % imagenesGaleria.length;
      actualizarImagen();
    };

    // 5. Asignar los clics a cada imagen de la galería
    imagenesGaleria.forEach((img, index) => {
      // Le agregamos un cursor pointer para que se note que es clickeable
      img.classList.add('cursor-pointer'); 
      img.addEventListener('click', () => abrirLightbox(index));
    });

    // 6. Asignar clics a los botones del modal
    btnCerrar.addEventListener('click', cerrarLightbox);
    btnNext.addEventListener('click', (e) => { e.stopPropagation(); siguienteFoto(); });
    btnPrev.addEventListener('click', (e) => { e.stopPropagation(); fotoAnterior(); });
    
    // Cerrar si hacen clic en el fondo negro (fuera de la foto)
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target.closest('div.relative') === null) {
        cerrarLightbox();
      }
    });

    // 7. Navegación con el teclado (Esc para cerrar, Flechas para mover)
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') cerrarLightbox();
      if (e.key === 'ArrowRight') siguienteFoto();
      if (e.key === 'ArrowLeft') fotoAnterior();
    });
  });
</script>