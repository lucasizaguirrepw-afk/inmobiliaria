---
import MainLayout from '../layouts/MainLayout.astro';
const nombreAgencia = import.meta.env.PUBLIC_AGENCIA_NOMBRE || "Inmobiliaria";
---

<MainLayout title="Contacto">
  <main class="max-w-5xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      
      <div>
        <h1 class="text-4xl font-black text-slate-900 mb-6">¿Tenés alguna consulta?</h1>
        <p class="text-lg text-slate-500 mb-10">Estamos para asesorarte. Completá el formulario o contactanos por nuestros canales oficiales.</p>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="text-2xl">📍</span>
            <div>
              <p class="font-bold text-slate-900">Nuestra Oficina</p>
              <p class="text-slate-500">Av. Libertador 1234, CABA</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-2xl">📧</span>
            <div>
              <p class="font-bold text-slate-900">Email</p>
              <p class="text-slate-500">consultas@inmobiliaria.com</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
        <form class="space-y-6" id="form-contacto">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Nombre Completo</label>
            <input type="text" id="nombre" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
            <input type="email" id="email" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Mensaje</label>
            <textarea id="mensaje" rows="4" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all"></textarea>
          </div>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl transition-colors shadow-lg shadow-blue-200">
            Enviar Mensaje
          </button>
        </form>
      </div>
    </div>
  </main>
</MainLayout>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', () => {
    const formContacto = document.getElementById('form-contacto');
    const btnSubmit = formContacto.querySelector('button[type="submit"]');

    formContacto.addEventListener('submit', async (e) => {
      e.preventDefault(); // Evitamos que la página se recargue

      const nombre = document.getElementById('nombre').value;
      const email = document.getElementById('email').value;
      const mensaje = document.getElementById('mensaje').value;

      const textoOriginal = btnSubmit.innerText;
      btnSubmit.innerText = 'Enviando...';
      btnSubmit.disabled = true;

      try {
        const { error } = await supabase
          .from('consultas')
          .insert([{ nombre, email, mensaje }]);

        if (error) throw error;

        alert('¡Mensaje enviado correctamente! Nos pondremos en contacto a la brevedad.');
        formContacto.reset(); // Limpiamos el formulario

      } catch (error) {
        alert('Hubo un error al enviar el mensaje. Por favor, intentá de nuevo.');
        console.error(error);
      } finally {
        btnSubmit.innerText = textoOriginal;
        btnSubmit.disabled = false;
      }
    });
  });
</script>