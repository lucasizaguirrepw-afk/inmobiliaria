---
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase.js';
import { optimizar } from '../lib/imagenes.js';

// Pedimos SOLO LAS 6 ÚLTIMAS propiedades para la Home
const { data: propiedades } = await supabase
  .from('propiedades')
  .select('*')
  .eq('activa', true)
  .order('created_at', { ascending: false })
  .limit(6);

const whatsapp = import.meta.env.PUBLIC_WHATSAPP || "5491123456789";
const mensajeWsp = "¡Hola! Estoy en la página web y me gustaría hacerles una consulta.";
const linkWsp = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensajeWsp)}`;
---

<MainLayout title="Inicio">
  <main>
    <section class="relative py-32 md:py-48 px-4 text-center overflow-hidden flex items-center justify-center min-h-[600px]">
      <div class="absolute inset-0 z-0">
        <div class="slide-bg absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style="background-image: url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');"></div>
        <div class="slide-bg absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');"></div>
        <div class="slide-bg absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');"></div>
        <div class="absolute inset-0 bg-slate-900/60"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto w-full">
        <h2 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg">Encontrá el lugar perfecto <br/>para tu próximo capítulo</h2>
        <p class="text-xl text-slate-200 mb-10 drop-shadow-md">Explorá las mejores propiedades en venta y alquiler.</p>

        <div class="bg-white/95 backdrop-blur-sm p-3 rounded-2xl shadow-2xl flex flex-col md:flex-row gap-3 max-w-4xl mx-auto">
           <input type="text" id="filtro-texto" placeholder="Ubicación o palabra clave..." class="flex-1 px-5 py-4 rounded-xl border border-slate-200 text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all text-lg" />
           <select id="filtro-operacion" class="px-5 py-4 rounded-xl border border-slate-200 text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none font-medium cursor-pointer text-lg">
             <option value="Todas">Cualquier Operación</option>
             <option value="Venta">Venta</option>
             <option value="Alquiler">Alquiler</option>
           </select>
           <button id="btn-buscar-home" class="bg-blue-600 hover:bg-blue-700 transition-colors text-white font-bold py-4 px-10 rounded-xl shadow-md text-lg">
              Buscar
           </button>
        </div>
      </div>
    </section>

    <section class="bg-white py-12 border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-xl mb-3">🏡</div>
          <h4 class="font-bold text-slate-900">Catálogo Exclusivo</h4>
          <p class="text-slate-500 text-sm mt-1">Propiedades seleccionadas meticulosamente.</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-xl mb-3">⚖️</div>
          <h4 class="font-bold text-slate-900">Asesoramiento Legal</h4>
          <p class="text-slate-500 text-sm mt-1">Operaciones transparentes y seguras.</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-xl mb-3">⚡</div>
          <h4 class="font-bold text-slate-900">Atención Rápida</h4>
          <p class="text-slate-500 text-sm mt-1">Respondemos tus consultas al instante.</p>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 bg-slate-50">
      <div class="text-center mb-12">
        <h3 class="text-3xl font-bold text-slate-900 tracking-tight">Últimos Ingresos</h3>
        <p class="text-slate-500 mt-2 text-lg">Las novedades más recientes del mercado.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {propiedades && propiedades.map((prop) => (
          <article class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 overflow-hidden group">
            <a href={`/propiedad/${prop.id}`} class="block h-full flex flex-col">
              <div class="h-64 bg-slate-200 relative overflow-hidden">
                <span class="absolute top-4 left-4 bg-slate-900 text-white text-xs font-black px-3 py-1.5 rounded-lg uppercase tracking-wider z-10">{prop.operacion}</span>
                {prop.imagen_principal
                  ? <img src={optimizar(prop.imagen_principal, 700)} loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                  : <div class="w-full h-full flex items-center justify-center text-slate-400 font-semibold">📷 Fotos próximamente</div>}
              </div>
              <div class="p-6 flex-1 flex flex-col">
                <p class="text-2xl font-black text-blue-600 mb-2">{prop.moneda} {prop.precio.toLocaleString('es-AR')}</p>
                <h4 class="text-lg font-bold text-slate-900 mb-2 line-clamp-1">{prop.titulo}</h4>
                <p class="text-slate-500 text-sm mb-4 line-clamp-2 flex-1">{prop.descripcion}</p>
                <div class="flex items-center justify-between text-sm font-medium text-slate-600 border-t border-slate-100 pt-4 mt-auto">
                  <span title="Ambientes">🛏️ {prop.ambientes}</span>
                  <span title="Baños">🛁 {prop.banios}</span>
                  <span title="Metros">📐 {prop.metros_cuadrados}m²</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-16 text-center">
        <a href="/propiedades" class="inline-block bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-4 px-10 rounded-xl transition-colors shadow-sm text-lg">
          Ver Catálogo Completo &rarr;
        </a>
      </div>
    </section>
  </main>

  <a href={linkWsp} target="_blank" aria-label="Contactar por WhatsApp" class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-4 rounded-full shadow-2xl hover:bg-[#1ebe57] hover:-translate-y-1 transition-all duration-300 group">
    <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
  </a>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // SLIDER DE FONDO
    const slides = document.querySelectorAll('.slide-bg');
    let currentSlide = 0;
    if(slides.length > 0) {
      setInterval(() => {
        slides[currentSlide].classList.remove('opacity-100');
        slides[currentSlide].classList.add('opacity-0');
        currentSlide = (currentSlide + 1) % slides.length;
        slides[currentSlide].classList.remove('opacity-0');
        slides[currentSlide].classList.add('opacity-100');
      }, 5000);
    }

    // BUSCADOR QUE ENVÍA AL CATÁLOGO
    const btnBuscar = document.getElementById('btn-buscar-home');
    btnBuscar?.addEventListener('click', () => {
      const texto = document.getElementById('filtro-texto').value;
      const operacion = document.getElementById('filtro-operacion').value;
      
      // Redirigimos a la página de propiedades con los parámetros en la URL
      window.location.href = `/propiedades?texto=${encodeURIComponent(texto)}&operacion=${encodeURIComponent(operacion)}`;
    });
  });
</script>